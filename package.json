# Copy to .env for local dev, or set these in Vercel's dashboard (Settings → Environment Variables).

# --- Claude API (generation) ---
# Get at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# --- Stripe (subscriptions) ---
# Get at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
# Create two Products in Stripe → copy each recurring Price ID (starts with price_)
STRIPE_PRICE_STARTER=price_xxxxxxxxxxxx
STRIPE_PRICE_PLATINUM=price_xxxxxxxxxxxx
# From Stripe → Developers → Webhooks, after adding endpoint https://yourdomain.com/api/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# --- Supabase (subscriber records) ---
# Get at https://supabase.com → your project → Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJxxxxxxxxxxxx

# --- Site ---
SITE_URL=https://yourdomain.com
